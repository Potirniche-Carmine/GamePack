{
  "name": "gamepack",
  "version": "1.0.1",
  "private": true,
  "scripts": {
    "start": "react-native start",
    "macos": "react-native run-macos",
    "typecheck": "tsc --noEmit",
    "test:ui": "node scripts/test-ui.mjs",
    "test:rust": "cargo test --workspace",
    "build:macos": "bash scripts/build-macos.sh",
    "install:macos": "bash scripts/install-macos.sh",
    "check:version": "node scripts/ci/check-version.mjs",
    "version:prepare": "node scripts/release/prepare-version.mjs",
    "test:release": "node --test tests/release/*.test.mjs",
    "build": "node scripts/desktop.mjs build",
    "app:install": "node scripts/desktop.mjs install",
    "package": "node scripts/desktop.mjs package",
    "release:prepare": "node scripts/release/prepare-release.mjs"
  },
  "dependencies": {
    "lucide-react-native": "^1.55.0",
    "react": "19.1.4",
    "react-native": "0.81.6",
    "react-native-macos": "0.81.9",
    "react-native-svg": "^15.15.5",
    "react-native-windows": "0.81.6"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/preset-env": "^7.25.3",
    "@babel/runtime": "^7.25.0",
    "@react-native-community/cli": "20.2.0",
    "@react-native-community/cli-platform-ios": "20.2.0",
    "@react-native/babel-preset": "0.81.6",
    "@react-native/metro-config": "0.81.6",
    "@react-native/typescript-config": "0.81.6",
    "@types/react": "19.1.4",
    "typescript": "^5.8.3"
  },
  "engines": {
    "node": ">=20"
  }
}
